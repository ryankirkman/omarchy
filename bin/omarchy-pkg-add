#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  if (( EUID == 0 )); then
    pacman -S --noconfirm --needed "$@" || exit 1
  else
    sudo pacman -S --noconfirm --needed "$@" || exit 1
  fi
fi

# Check the whole transaction even when pacman reports success. The usual path
# opens the database once; only a failed postflight needs per-package queries to
# preserve the diagnostic naming the first package that did not install.
if (( $# > 0 )) && ! pacman -Q "$@" &>/dev/null; then
  for pkg in "$@"; do
    if ! pacman -Q "$pkg" &>/dev/null; then
      echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
      exit 1
    fi
  done
fi

exit 0
