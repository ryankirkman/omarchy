diff --git a/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py b/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py
index 4843cc6..c0d40d1 100644
--- a/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py
+++ b/configs/airootfs/usr/share/omarchy-iso/orchestrator/phases_impl.py
@@ -625,10 +625,13 @@ def _install_root_image(ctx: InstallContext) -> None:
         _restore_root_image(stream, device)
         # A byte-for-byte filesystem clone must never keep the image's FSID:
         # two installed disks can be connected to the same machine, and Btrfs
-        # identifies filesystems by this value. -u rewrites the full UUID (not
-        # the lighter metadata_uuid compatibility mode) and -f is the command's
-        # non-interactive acknowledgement.
-        subprocess.run(["btrfstune", "-f", "-u", device], check=True)
+        # identifies filesystems by this value. Keep the full metadata rewrite
+        # by default. The opt-in experiment changes only the filesystem ID in
+        # the superblocks, using the metadata_uuid feature (Linux >= 5.0).
+        # Before enabling that default, validate two clones mounted together,
+        # installed boot, and snapshot rollback with this exact ISO/kernel.
+        uuid_mode = "-m" if os.environ.get("OMARCHY_EXPERIMENTAL_FAST_UUID") == "1" else "-u"
+        subprocess.run(["btrfstune", "-f", uuid_mode, device], check=True)
 
         subprocess.run(["mount", "-o", "subvolid=5", device, str(top)], check=True)
         top_mounted = True
